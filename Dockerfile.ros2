FROM ros:humble-ros-base

ENV DEBIAN_FRONTEND=noninteractive

# Core build tools + all native dependencies Klampt expects
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    pkg-config \
    python3-dev \
    python3-pip \
    libgl1-mesa-dev \
    libglu1-mesa-dev \
    libx11-dev \
    libxi-dev \
    libxmu-dev \
    freeglut3-dev \
    libglew-dev \
    libglpk-dev \
    libcurl4-openssl-dev \
    libfreeimage-dev \
    liblog4cxx-dev \
    libassimp-dev \
    libode-dev \
    doxygen \
    openssh-client \
    autoconf \
    automake \
    libtool \
 && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --upgrade pip && \
    python3 -m pip install numpy

RUN git config --global url."https://github.com/".insteadOf git@github.com:

# Build and install KrisLibrary once so it is available system-wide
RUN git clone https://github.com/krishauser/KrisLibrary.git /tmp/KrisLibrary && \
    cmake -S /tmp/KrisLibrary -B /tmp/KrisLibrary/build -DCMAKE_BUILD_TYPE=Release && \
    cmake --build /tmp/KrisLibrary/build --target install -- -j$(nproc) && \
    rm -rf /tmp/KrisLibrary

WORKDIR /workspace

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]

FROM ros:humble-ros-base

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive

# Core build tools + all native dependencies Klampt expects
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    pkg-config \
    python3-dev \
    python3-pip \
    libgl1-mesa-dev \
    libglu1-mesa-dev \
    libx11-dev \
    libxi-dev \
    libxmu-dev \
    freeglut3-dev \
    libglew-dev \
    libglpk-dev \
    libcurl4-openssl-dev \
    libfreeimage-dev \
    liblog4cxx-dev \
    libassimp-dev \
    libode-dev \
    ros-humble-rclcpp \
    ros-humble-std-msgs \
    ros-humble-geometry-msgs \
    ros-humble-sensor-msgs \
    ros-humble-trajectory-msgs \
    ros-humble-tf2 \
    ros-humble-tf2-ros \
    ros-humble-rosgraph-msgs \
    ros-humble-statistics-msgs \
    ros-humble-action-msgs \
    ros-humble-unique-identifier-msgs \
    ros-humble-rosidl-typesupport-cpp \
    doxygen \
    openssh-client \
    autoconf \
    automake \
    libtool \
    qtbase5-dev \
    libqt5opengl5-dev \
    libxcb-cursor0 \
 && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --upgrade pip && \
    python3 -m pip install numpy

RUN git config --global url."https://github.com/".insteadOf git@github.com:

# Build and install KrisLibrary once so it is available system-wide
RUN git clone https://github.com/krishauser/KrisLibrary.git /opt/KrisLibrary \
    && cmake -S /opt/KrisLibrary -B /opt/KrisLibrary/build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /opt/KrisLibrary/build --target install -- -j$(nproc)

ENV CMAKE_PREFIX_PATH=/usr/local:${CMAKE_PREFIX_PATH}
ENV CMAKE_MODULE_PATH=/opt/KrisLibrary/CMakeModules:${CMAKE_MODULE_PATH}

# Build and install the bundled ODE dependency
COPY Cpp/Dependencies/ode-0.14 /tmp/ode-0.14
RUN cd /tmp/ode-0.14 && \
    CFLAGS="-fPIC" CXXFLAGS="-fPIC" ./configure --enable-double-precision --enable-shared --disable-static --disable-demos && \
    make -j$(nproc) && \
    make install && \
    rm -rf /tmp/ode-0.14

ENV AMENT_PREFIX_PATH=/opt/ros/humble
ENV LD_LIBRARY_PATH=/usr/local/lib:/opt/ros/humble/lib:${LD_LIBRARY_PATH}

# Copy Klampt source code
COPY . /opt/Klampt

# Create symlink so Klampt can find KrisLibrary where it expects it
RUN ln -s /opt/KrisLibrary /opt/Klampt/Cpp/Dependencies/KrisLibrary

# Build Klampt C++ library and Python bindings
RUN cd /opt/Klampt && \
    mkdir -p build && cd build && \
    cmake .. -DKLAMPT_ROS_VERSION=ROS2 \
             -DCMAKE_BUILD_TYPE=Release && \
    make -j$(nproc) && \
    make python

# Set Python environment variable for the build
ENV PYTHON3=/usr/bin/python3

# pip installs
RUN python3 -m pip install PyQt6 pillow

# Create workspace directory for user code
WORKDIR /workspace

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
